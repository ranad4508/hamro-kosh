rules_version = '2';

// Hamro Kosh — Firestore security rules.
// Implements SRS §50 (role-based access, no member can touch another
// member's financial records) and §51 (financial records are admin-written
// and never hard-deleted). Transparency features (§10-§12, §25, §54) mean
// approved/active members get broad READ access to fund-wide collections;
// only an admin/super admin may write financial data.
//
// RBAC (SRS.md §58): three roles — member, admin, superAdmin. The super
// admin is provisioned once, manually (see README.md), never through any
// client write, is never deletable, and can never be demoted through the
// bulk admin-update path below (only self-edits to name/phone/photo reach
// a superAdmin doc from a client). Minting new member/admin accounts with
// emailed credentials goes through `functions/index.js` (Admin SDK, which
// bypasses these rules entirely) — never a direct client write.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers --------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function selfData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin actions require the acting account to also be active, so
    // disabling an admin's account (SRS §35) immediately revokes admin
    // write access without needing a separate role change. Both admin and
    // superAdmin count — see the RBAC note above.
    function isAdmin() {
      return isSignedIn()
        && (selfData().role == 'admin' || selfData().role == 'superAdmin')
        && selfData().isActive == true;
    }

    // Only the super admin manages other admin accounts (approve/enable/
    // disable) — a plain admin's Manage Members reach stops at role
    // 'member'. See the `users/{userId}.update` rule below and
    // AdminMembersScreen, which scopes what a plain admin even sees to
    // match.
    function isSuperAdmin() {
      return isSignedIn() && selfData().role == 'superAdmin' && selfData().isActive == true;
    }

    // "Member" for transparency reads means active — there is no approval
    // step and no invite code (only member/admin/superAdmin roles exist; no
    // separate "treasurer" or moderation queue). Anyone with the app can
    // register via `registerMember` and is immediately active.
    function isActiveMember() {
      return isSignedIn() && selfData().isActive == true;
    }

    // ---- users/{uid} + subcollections -----------------------------------

    match /users/{userId} {
      // Own profile always readable; any member's profile is readable by
      // any other active member for the community directory (§31).
      allow get: if isSelf(userId) || isAdmin() || isActiveMember();
      allow list: if isAdmin() || isActiveMember();

      // Registration writes its own doc (§3). Must not self-grant admin or
      // spoof its auth email. In practice this path isn't used — self-
      // registration goes through the `registerMember` Cloud Function
      // (Admin SDK, bypasses these rules) so the invite-code check and the
      // Auth-user-plus-profile write happen atomically — but this stays as
      // a defensive floor in case a client ever writes here directly.
      allow create: if isSelf(userId)
        && request.resource.data.role == 'member'
        && request.resource.data.isActive == true
        && request.resource.data.email == request.auth.token.email;

      // Enable/disable hierarchy: a super admin manages any admin-or-member
      // account; a plain admin's reach stops at `member` accounts — one
      // admin can never disable or otherwise edit another admin's account,
      // only a super admin can. Neither path can ever touch a superAdmin
      // doc (protects it from demotion/disabling) or grant the superAdmin
      // role to anyone. Members may only edit their own non-privileged
      // profile fields.
      allow update: if (isSuperAdmin()
            && resource.data.role != 'superAdmin'
            && request.resource.data.role != 'superAdmin')
        || (isAdmin() && !isSuperAdmin()
            && resource.data.role == 'member'
            && request.resource.data.role == 'member')
        || (isSelf(userId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['fullName', 'phone', 'photoUrl', 'mustChangePassword', 'fcmToken', 'emailPreferences']));

      // A super admin's document is never deletable, by anyone (SRS.md §58).
      // Not reachable from the client today (SRS §35 — accounts are
      // disabled, never deleted, to preserve historical financial records)
      // but scoped to the same hierarchy as `update` in case that changes.
      allow delete: if isSuperAdmin() && resource.data.role != 'superAdmin'
        || (isAdmin() && !isSuperAdmin() && resource.data.role == 'member');

      // A member's own contribution history + the admin verification queue
      // (§7-§9, §38). Once submitted, only an admin can change its status
      // (verify/reject) — corrections must go through admin review, never
      // a member edit.
      match /contributions/{contributionId} {
        // Member-to-member visibility is a core stated principle here
        // (SRS §2.1 "view other members' contributions", §12/§54 "every
        // rupee traceable") — the same transparency `loans` already gets
        // below, not an admin-only view.
        allow read: if isSelf(userId) || isAdmin() || isActiveMember();
        allow create: if isSelf(userId)
          && request.resource.data.memberUid == userId
          && request.resource.data.status == 'pending'
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        // Verifying/rejecting is a Cloud Function (`verifyContribution` in
        // functions/index.js), not a client write: it also has to record a
        // ledger entry and update the fund total atomically, which no rule
        // here can express. The Admin SDK bypasses these rules entirely, so
        // this stays `false` even for admins.
        allow update: if false;
        allow delete: if false;
      }

      // Per-member notification center (§45). Members may only flip the
      // read flag on their own notifications; admins/Cloud Functions author
      // the entries.
      match /notifications/{notificationId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create: if isAdmin();
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow delete: if isSelf(userId) || isAdmin();
      }
    }

    // A plain `match /users/{userId}/contributions/{contributionId}` rule
    // (above) only ever governs a `get` or a query already scoped to one
    // known parent (`users/X/contributions`) — Firestore never consults it
    // for a `collectionGroup('contributions')` query, no matter how
    // permissive it is. `ContributionsRepository`/`CampaignsRepository` both
    // run exactly that collection-group query (to find every member's
    // pending contributions at once for the admin verification queue), so
    // without this recursive-wildcard sibling rule that query is always
    // denied with PERMISSION_DENIED — this was a real rules gap, not a
    // per-account data issue.
    match /{path=**}/contributions/{contributionId} {
      allow read: if isAdmin() || isActiveMember();
    }

    // ---- fund-wide financial ledger --------------------------------------

    // The transparent transaction ledger (§11/§12/§54). Every member can see
    // where money came from and went; only admins record entries, and
    // entries are never deleted (§51 rule 3) — corrections must be new,
    // audited entries, not edits to history. Loosen `update` further to
    // `false` once the admin correction flow always appends instead of
    // mutating in place.
    match /transactions/{transactionId} {
      allow read: if isActiveMember() || isAdmin();
      // Every ledger entry is written by a Cloud Function (`verifyContribution`
      // / `approveLoan`) alongside the fund total it affects — never a direct
      // client write, even from an admin session (SRS §36/§37: financial
      // totals need one reliable, server-enforced source of truth).
      allow create, update: if false;
      allow delete: if false;
    }

    // Loan requests/approvals/repayments (§15-§25). A member may create
    // their own loan request in `requested` status; approving, rejecting, or
    // disbursing is a Cloud Function (`approveLoan` in functions/index.js),
    // not a client write — same reasoning as `contributions` above. Loan
    // existence/status is visible fund-wide for transparency (§25/§54: "who
    // has an outstanding loan").
    match /loans/{loanId} {
      allow read: if isActiveMember() || isAdmin();
      allow create: if isActiveMember()
        && request.resource.data.memberId == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.amountPaid == 0
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.category in ['personal', 'emergency'];
      allow update: if false;
      allow delete: if false;
    }

    // Repayment claims against a loan (§21) — same shape as contributions:
    // a member submits "I paid NPR X" in `pending` status; only the
    // `verifyRepayment` Cloud Function can move it to verified/rejected,
    // since verifying also splits the payment into principal/interest/
    // penalty and updates the loan + fund totals atomically.
    match /loan_repayments/{repaymentId} {
      allow read: if isActiveMember() || isAdmin();
      allow create: if isActiveMember()
        && request.resource.data.memberUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && get(/databases/$(database)/documents/loans/$(request.resource.data.loanId)).data.memberId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Admin-authored community announcements (§33), broadcast to everyone.
    match /announcements/{announcementId} {
      allow read: if isActiveMember() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Named special-contribution campaigns with a target (§15), e.g.
    // "Dashain Contribution 2083" — admin-authored, member-visible.
    match /campaigns/{campaignId} {
      allow read: if isActiveMember() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Member-raised issue reports ("report transaction issues" / dispute
    // handling) — unlike the fully transparent collections above, these can
    // contain a personal complaint, so only the reporter and admins can
    // read one, not every active member.
    match /disputes/{disputeId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.memberUid == request.auth.uid
        && request.resource.data.status == 'open';
      // Only an admin resolves one; the reporter can't edit after
      // submitting (corrections go through admin review, same principle
      // as contributions/loans).
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Configurable contribution/loan/interest rules (§18/§39). Members need
    // to see these (e.g. before accepting loan terms, §19); only admins
    // change them.
    match /settings/fund_rules {
      allow read: if isActiveMember() || isAdmin();
      allow write: if isAdmin();
    }

    // Admin-configurable member-to-member visibility (§29) — see
    // PrivacySettings's doc comment for exactly what this gates.
    match /settings/privacy {
      allow read: if isActiveMember() || isAdmin();
      allow write: if isAdmin();
    }

    // The fund's own eSewa/bank account details (`design_spec.md` §6 — all
    // contributions and repayments pay into this one fund-owned account,
    // never a member's own account). Members need to read it on the Give
    // screen; only an admin edits it, and it's a simple settings doc with
    // no atomicity concerns, so a direct client write is fine here.
    match /settings/fund_account {
      allow read: if isActiveMember() || isAdmin();
      allow write: if isAdmin();
    }

    // Admin-authored transactional email templates (`design_spec.md` §4f).
    // Read/written by the admin UI directly (no atomicity concerns — it's
    // just template text); consumed server-side by Cloud Functions via the
    // Admin SDK when actually sending an email.
    match /email_templates/{templateId} {
      allow read, write: if isAdmin();
    }

    // Admin-only audit trail (§40/§41) — not part of the member navigation.
    // Append-only: no entry is ever edited or removed once written.
    match /audit_log/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Aggregated fund summary shown on the transparency dashboard (§6/§54).
    // Only ever incremented by a Cloud Function alongside the ledger entry
    // that caused the change — never a direct client write.
    match /fund/summary {
      allow read: if isActiveMember() || isAdmin();
      allow write: if false;
    }
  }
}
